        { "name": "Medicine", "description": "Medicina y sanacion.", "values": { "attribute": "Intellect", "tasks": "Tratar heridas y enfermedades. Ventaja con Suministros Quirurgicos." } },
        { "name": "Thievery", "description": "Robo y mecanismos.", "values": { "attribute": "Intellect", "tasks": "Abrir cerraduras. Esferas DC 15, Candados DC 20, Esposas DC 20. Ganzua da ventaja." } },
