  "skill_formats": [
    {
      "name": "Stormlight Skills",
      "description": "Las 15 habilidades documentadas del Stormlight RPG. Cada habilidad declara su atributo gobernante y las tareas que cubre.",
      "fields": [
        { "name": "attribute", "type": "text" },
        { "name": "tasks", "type": "text" }
      ],
      "skills": [
        { "name": "Athletics", "description": "Proeza fisica.", "values": { "attribute": "Strength", "tasks": "Levantar, empujar, escalar, saltar, jalar. Salto horizontal gratis = tamano propio. DC 10 para mas. DC 30 para abismo de 40 pies." } },
        { "name": "Heavy Weaponry", "description": "Combate con armas pesadas.", "values": { "attribute": "Strength", "tasks": "Ataques con armas de dos manos, pesadas o de alcance en combate." } },
        { "name": "Agility", "description": "Reflejos y movilidad.", "values": { "attribute": "Speed", "tasks": "Moverse por el entorno, acrobacias, pilotar vehiculos. Se prueba cuando reflejos o movilidad estan en juego." } },
        { "name": "Light Weaponry", "description": "Combate con armas ligeras.", "values": { "attribute": "Speed", "tasks": "Ataques con armas ligeras en combate." } },
        { "name": "Stealth", "description": "Sigilo y ocultamiento.", "values": { "attribute": "Speed", "tasks": "Moverse sin ser detectado. Usado en iniciativa Sorpresa vs Perception." } },
        { "name": "Trickery", "description": "Engano fisico.", "values": { "attribute": "Speed", "tasks": "Engano fisico, prestidigitacion, robar bolsillos." } },
        { "name": "Lore", "description": "Conocimiento especializado.", "values": { "attribute": "Intellect", "tasks": "Conocimiento historico, cultural y arcano." } },
        { "name": "Crafting", "description": "Fabricacion y construccion.", "values": { "attribute": "Intellect", "tasks": "Fabricar, reparar o modificar objetos y dispositivos." } },
        { "name": "Deduction", "description": "Razonamiento logico.", "values": { "attribute": "Intellect", "tasks": "Analizar evidencia, resolver acertijos, deducir informacion oculta." } },
        { "name": "Medicine", "description": "Medicina y sanacion.", "values": { "attribute": "Intellect", "tasks": "Tratar heridas y enfermedades. Ventaja con Suministros Quirurgicos." } },
        { "name": "Thievery", "description": "Robo y mecanismos.", "values": { "attribute": "Intellect", "tasks": "Abrir cerraduras. Esferas DC 15, Candados DC 20, Esposas DC 20. Ganzua da ventaja." } },
        { "name": "Discipline", "description": "Control mental.", "values": { "attribute": "Willpower", "tasks": "Resistencia mental, concentracion, autocontrol. Usado para instrumentos de teclado." } },
        { "name": "Intimidation", "description": "Amedrentar a otros.", "values": { "attribute": "Willpower", "tasks": "Intimidar, amenazar o infundir miedo para obtener un resultado." } },
        { "name": "Survival", "description": "Supervivencia.", "values": { "attribute": "Willpower", "tasks": "Encontrar recursos en la naturaleza. Forrajear durante descanso corto." } },
        { "name": "Insight", "description": "Intuicion social.", "values": { "attribute": "Awareness", "tasks": "Detectar enganos, leer emociones. Usado vs Deception en iniciativa Sorpresa." } },
        { "name": "Perception", "description": "Percepcion sensorial.", "values": { "attribute": "Awareness", "tasks": "Detectar cosas ocultas o a distancia. Usado vs Stealth en iniciativa Sorpresa." } },
        { "name": "Deception", "description": "Engano verbal.", "values": { "attribute": "Presence", "tasks": "Enganar verbalmente. Usado en Sorpresa vs Insight." } },
        { "name": "Influence", "description": "Influencia social.", "values": { "attribute": "Presence", "tasks": "Persuadir, negociar, intimidar." } },
        { "name": "Leadership", "description": "Liderazgo y mando.", "values": { "attribute": "Presence", "tasks": "Dirigir, inspirar o coordinar a un grupo hacia un objetivo." } },
        { "name": "Persuasion", "description": "Persuasion y negociacion.", "values": { "attribute": "Presence", "tasks": "Convencer a otros mediante argumentos logicos o apelaciones emocionales." } },
        { "name": "Performance", "description": "Artes escenicas.", "values": { "attribute": "Presence", "tasks": "Actuacion, musica, expresion artistica. Agility para cuerdas, Athletics para percusion, Discipline para teclados." } }
      ]
    }
