# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
DB_PATH=./data/rolapp.db

# ── IA / RAG ────────────────────────────────────────────────────────────────────
# HÍBRIDO: por defecto Ollama local; se puede cambiar a una API externa por env,
# SIN tocar código. Levanta la IA local con:  docker compose --profile ai up
# y descarga los modelos con:  docker compose --profile ai run --rm ai-bootstrap
#                        (o):  sh scripts/ai-bootstrap.sh

# Motor del LLM y de los embeddings: ollama | api (pueden diferir).
AI_PROVIDER=ollama
EMBED_PROVIDER=ollama

# ── Opción A: Ollama local (por defecto) ──────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text     # embeddings (768 dims)
AI_MODEL=qwen2.5:3b              # LLM local pequeño (alternativas: llama3.2:3b)

# ── Opción B: API externa (estilo OpenAI) ─────────────────────────────────────
# Descomenta y ajusta si AI_PROVIDER=api y/o EMBED_PROVIDER=api:
# AI_PROVIDER=api
# EMBED_PROVIDER=api
# API_KEY=sk-...                       # clave de la API
# AI_MODEL=gpt-4o-mini                 # modelo del LLM en la API
# EMBED_MODEL=text-embedding-3-small   # OJO: 768 dims esperadas por el vector store
# AI_API_BASE_URL=https://api.openai.com/v1   # base del LLM (chat/completions)
# EMBED_API_URL=https://api.openai.com/v1      # base de embeddings (/embeddings)

# ── Retrieval / RAG tuning (F11) ──────────────────────────────────────────────
# Chunking: tamaño objetivo/tope y solape en "tokens" (~= chars/4). No parte tablas.
RAG_CHUNK_TARGET_TOKENS=400
RAG_CHUNK_MAX_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=60

# Fusión híbrida: pesos de las dos señales al combinar vector + keyword.
#   fused = W_vec*RRF(rank_vec) + W_kw*RRF(rank_kw) + blend*(W_vec*sim_vec + W_kw*bm25_norm)
RAG_VECTOR_WEIGHT=1
RAG_KEYWORD_WEIGHT=1

# Diversidad (MMR): 0 = solo relevancia, 1 = solo diversidad. 0.3 = ligero anti-redundancia.
RAG_MMR_LAMBDA=0.3

# Nº de chunks que recupera el asistente antes de empaquetar por presupuesto.
RAG_RETRIEVE_K=8
# Presupuesto de tokens del contexto enviado al LLM (los mejores chunks hasta el límite).
RAG_CONTEXT_TOKEN_BUDGET=1500

# Caché en memoria del embedding de queries repetidas (Nº máx. de entradas, LRU).
RAG_QUERY_CACHE_SIZE=256
